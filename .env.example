NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: dedicated secret for the 20-minute signed admin access cache.
# If omitted, SUPABASE_SERVICE_ROLE_KEY is used as the signing secret.
ADMIN_ACCESS_CACHE_SECRET=
FJPANEL_API_KEY=
ZIBAL_MERCHANT=
# Optional: HTTP/S proxy for Zibal outbound calls. Fixie provides two stable egress IPs.
FIXIE_URL=
# Optional: allows protected manual sync without an admin bearer token.
SOCIAL_SYNC_SECRET=
# Base64-encoded 32-byte random secret for encrypting stored Gemini API keys.
AI_PROFILE_ENCRYPTION_KEY=
# Optional server-side Gemini gateway. Leave unset to use Google's official API endpoint.
GEMINI_API_BASE_URL=
# Google Search Console server-side access. Prefer the JSON variable on Vercel.
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_JSON=
# Or provide these two values separately.
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Search Console property, e.g. sc-domain:tusancn.ir or https://www.tusancn.ir/
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:tusancn.ir
# Google OAuth Web Client ID used by Google One Tap.
# Create/configure this in Google Cloud and use the same client ID configured for Supabase Google Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Canonical public website origin used for payment callbacks and gateway domain matching.
PUBLIC_SITE_URL=https://tusancn.ir

# AI support multi-provider
SUPPORT_AI_PROVIDERS=xai,gemini
SUPPORT_XAI_MODEL=grok-4.7
SUPPORT_GEMINI_MODEL=gemini-3.6-flash
XAI_API_KEY_1=
XAI_API_KEY_2=
XAI_API_KEY_3=
XAI_API_KEY_4=
XAI_API_KEY_5=
